{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/img/:barcode",
      "destination": "/api/img?barcode=:barcode"
    },
    {
      "source": "/api/product",
      "destination": "/api/product.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

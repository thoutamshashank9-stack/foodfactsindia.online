{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap.js" },
    { "source": "/sitemaps/:name", "destination": "/api/sitemaps.js?name=:name" },
    { "source": "/food", "destination": "/api/food-database.js" },
    { "source": "/admin/seo", "destination": "/api/admin-seo.js" },
    { "source": "/research/most-common-food-additives-in-india", "destination": "/api/research/most-common-additives.js" },
    { "source": "/tools/food-label-checker", "destination": "/api/tools/food-label-checker.js" },
    { "source": "/tools/ingredient-checker", "destination": "/api/tools/ingredient-checker.js" },
    { "source": "/tools/food-label-scanner", "destination": "/api/tools/food-label-scanner.js" },
    { "source": "/guides/how-to-read-food-labels", "destination": "/api/guides/how-to-read-food-labels.js" },
    { "source": "/guides/how-to-read-ingredients", "destination": "/api/guides/how-to-read-ingredients.js" },
    { "source": "/guides/how-to-read-nutrition-labels", "destination": "/api/guides/how-to-read-nutrition-labels.js" },
    { "source": "/guides/what-are-ins-numbers", "destination": "/api/guides/what-are-ins-numbers.js" },
    { "source": "/guides/food-additives", "destination": "/api/guides/food-additives.js" },
    { "source": "/fssai/food-labelling", "destination": "/api/fssai/food-labelling.js" },
    { "source": "/food/:slug", "destination": "/api/food.js?slug=:slug" },
    { "source": "/ingredient/:slug", "destination": "/api/ingredient.js?slug=:slug" },
    { "source": "/additive/:slug", "destination": "/api/additive.js?slug=:slug" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
